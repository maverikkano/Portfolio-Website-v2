---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const description = `Essays on retrieval, evaluation, and production LLM systems by ${SITE.name}.`;
---

<BaseLayout title="Blog" description={description}>
  <header class="mb-5">
    <h1 class="mb-2">Blog</h1>
    <p class="text-body-secondary mb-0">{description}</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="text-body-secondary">No posts yet.</p>
    ) : (
      <ul class="list-unstyled mb-0">
        {posts.map((post) => (
          <li class="mb-5">
            <h2 class="h5 mb-2">
              <a class="link-body-emphasis text-decoration-none" href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>
            <p class="text-body-secondary">{post.data.description}</p>
            <p class="d-flex flex-wrap align-items-center gap-3 small text-body-secondary mb-0">
              <FormattedDate date={post.data.pubDate} />
              {post.data.tags.length > 0 && (
                <span class="d-flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="badge rounded-pill text-body-secondary border fw-normal">
                      {tag}
                    </span>
                  ))}
                </span>
              )}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
