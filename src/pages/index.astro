---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout>
  <header class="page-header">
    <h1>{SITE.name}</h1>
    <p>{SITE.role}</p>
  </header>

  <section aria-labelledby="focus-heading">
    <h2 id="focus-heading">Focus areas</h2>
    <ul class="card-grid">
      <li class="card">
        <h3>Retrieval &amp; RAG</h3>
        <p>Hybrid search, chunking strategy, and reranking tuned against real queries.</p>
      </li>
      <li class="card">
        <h3>Evaluation</h3>
        <p>Offline eval harnesses, LLM-as-judge with calibration, regression gates in CI.</p>
      </li>
      <li class="card">
        <h3>Inference infra</h3>
        <p>Serving, batching, caching, and cost observability for production traffic.</p>
      </li>
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section aria-labelledby="writing-heading">
        <div class="section-heading">
          <h2 id="writing-heading">Recent writing</h2>
          <a href="/blog">All posts →</a>
        </div>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <h3 class="post-list__title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="muted">{post.data.description}</p>
              <p class="post-meta">
                <FormattedDate date={post.data.pubDate} />
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
