---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/bootstrap.scss';
import '../styles/prose.scss';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { title = '', description, type, publishedTime } = Astro.props;
---

<!doctype html>
<html lang="en" data-bs-theme="dark">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={Astro.url.pathname}
      type={type}
      publishedTime={publishedTime}
    />
  </head>
  <!-- min-vh-100 + flex column keeps the footer at the bottom on short pages,
       replacing the old `.site-footer { margin-top: auto }` rule. -->
  <body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="flex-grow-1 py-5">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
    <script>
      import 'bootstrap/dist/js/bootstrap.bundle.min.js';
    </script>
  </body>
</html>
