# Copy to `.env` and edit. Every value is optional — defaults live in `src/consts.ts`.
# Astro exposes these to the build; nothing here is secret unless you add secrets.

# --- Identity -----------------------------------------------------------------
# Production origin. Used for canonical URLs, Open Graph tags, and sitemaps.
SITE_URL=https://example.com

# Your name. Used in the header, footer, and author metadata.
SITE_NAME=Abhishek Patil

# Optional override for the tab title. Defaults to SITE_NAME.
SITE_TITLE=

# Text shown before your name in the header, e.g. "$", "~/", ">".
SITE_LOGO=$

SITE_ROLE=AI Engineer
SITE_LOCATION=Remote
SITE_DESCRIPTION=AI engineer building retrieval systems, evaluation harnesses, and production LLM infrastructure.

# --- Contact ------------------------------------------------------------------
SITE_EMAIL=hello@example.com
SITE_PHONE=

# --- Avatar -------------------------------------------------------------------
# Path to a file you place in `public/`, e.g. /avatar.jpg.
# If the file is missing the landing page falls back to a placeholder.
SITE_AVATAR=/avatar.jpg

# --- Social links (leave blank to hide) ---------------------------------------
SITE_GITHUB=
SITE_LINKEDIN=
SITE_X=
